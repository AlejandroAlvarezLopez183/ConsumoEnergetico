# Copia este archivo a .env y rellena los valores.
# docker compose lo carga automáticamente desde la raíz del proyecto.
#
# Las credenciales de Tuya NO van aquí: el compose las toma del .env del
# backend (backend/.env) vía env_file, para no duplicar secretos.
# Ver docker-compose.yml (servicio backend).

# ── Recolección 24/7 ───────────────────────────────────────────
# Segundos entre rondas de recolección (por defecto 600 = 10 min).
COLLECT_INTERVAL_SECONDS=600
# Zona horaria del contenedor (el script usa America/Monterrey internamente).
TZ=America/Monterrey

# ── ETL (CSV -> data.json) ─────────────────────────────────────
# Segundos entre corridas del etl (por defecto 3600 = 1 hora).
ETL_INTERVAL_SECONDS=3600

# ── Frontend ───────────────────────────────────────────────────
# Puerto del host donde se publica el sitio.
FRONTEND_PORT=8080
